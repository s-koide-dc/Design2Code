      "assets": [
        {"id": "chive_model", "path": "resources/vectors/chive-1.3-mc90.txt"},
        {"id": "chive_vocab", "path": "resources/vectors/chive-1.3-mc90.txt.v0.vocab.npy"},
        {"id": "chive_matrix", "path": "resources/vectors/chive-1.3-mc90.txt.v0.matrix.npy"}
